rules_version = '2';

// Deploy with: npx firebase deploy --only firestore:rules
// Without this file the database runs on whatever the console has — "test mode" leaves
// it open to everyone until it expires (then denies everything), so keep it versioned.
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per user, holding that user's whole watch list. Only the owner can
    // read or write it; signed-out requests are denied outright.
    match /watchLists/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Anything not matched above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

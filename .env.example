# StreamLens environment variables
#
# Setup: copy this file to .env.local (gitignored) and fill in the values:
#   cp .env.example .env.local
# Restart `npm run dev` after editing; Vite only reads env files at startup.

# ─── TMDB ────────────────────────────────────────────────────────────────────
# Required. Use the "API Read Access Token" (the long one, not the short API key):
# https://www.themoviedb.org/settings/api
VITE_TMDB_READ_ACCESS_TOKEN=

# ─── Firebase ────────────────────────────────────────────────────────────────
# Required for sign-in and the watch list. Copy these from the Firebase console:
# Project settings → General → Your apps → Web app → SDK setup and configuration.
# They aren't secrets (they ship to every browser); Firestore rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional (Google Analytics).
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Social sign-in ──────────────────────────────────────────────────────────
# Which provider buttons appear in the sign-in modal. Only the exact value `true`
# enables one. The provider must also be enabled in Firebase console →
# Authentication → Sign-in method.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_FACEBOOK_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false
